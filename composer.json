{
    "type": "project",
    "license": "MIT",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-intl": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "nyholm/psr7": "^1.8",
        "pagerfanta/core": "^4.11",
        "symfony/ai-anthropic-platform": "^1.0@beta",
        "symfony/ai-bundle": "^1.0@beta",
        "symfony/ai-mcp-tool": "^1.0@beta",
        "symfony/ai-session-message-store": "^1.0@beta",
        "symfony/asset-mapper": "^8.1",
        "symfony/clock": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.12",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/mcp-bundle": "^1.0@beta",
        "symfony/monolog-bundle": "^4.1",
        "symfony/rate-limiter": "^8.1",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "^8.1",
        "symfony/security-csrf": "^8.1",
        "symfony/stimulus-bundle": "^3.7",
        "symfony/translation": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/ux-turbo": "^3.7",
        "symfony/validator": "8.1.*",
        "symfony/workflow": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/extra-bundle": "^3.29",
        "twig/intl-extra": "^3.30"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "friendsofphp/php-cs-fixer": "*",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4",
        "playwright-php/playwright-symfony": "^0.12.0",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "^8.1",
        "symfony/web-profiler-bundle": "^8.1"
    }
}
