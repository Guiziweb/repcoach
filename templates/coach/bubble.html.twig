<div class="bubble" id="bubble" tabindex="0" data-action="click->ask#open keydown.enter->ask#open">
    <p data-ask-target="text">{{ say }}</p>
    {% if confirm|default(null) %}
        <div class="confirm">
            <button form="ask" formaction="{{ path('coach_confirm') }}" formnovalidate name="id" value="{{ confirm.id }}">{{ 'buddy.confirm'|trans({action: confirm.action}) }}</button>
        </div>
    {% endif %}
    {% if tools|default([]) is not empty %}
        <ul class="trail">
            {% for tool in tools %}
                <li class="tool{{ tool.reads ? '' : ' is-write' }}">
                    {{ tool.name }}{% if tool.count > 1 %}<span class="tool-count">×{{ tool.count }}</span>{% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
