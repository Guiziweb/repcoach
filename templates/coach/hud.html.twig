<div class="hud" id="hud">
    {% if consumption %}
        <span class="memory{{ consumption.memory >= 80 ? ' is-high' }}" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ consumption.memory }}" aria-label="{{ 'hud.memory'|trans }}">
            {{ 'hud.memory'|trans }}
            <span class="gauge"><span class="gauge-fill" style="width: {{ consumption.memory }}%"></span></span>
            <b>{{ (consumption.memory / 100)|format_number(style: 'percent') }}</b>
        </span>
    {% endif %}
    <form action="{{ path('coach_forget') }}" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('coach') }}">
        <button class="forget" title="{{ 'hud.forget'|trans }}" aria-label="{{ 'hud.forget'|trans }}">↺</button>
    </form>
</div>
