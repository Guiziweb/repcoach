<div class="hud" id="hud">
    {% if consumption %}
        <span>{{ 'hud.context'|trans }} <b>{{ consumption.context|format_number }}</b></span>
        <span title="{{ 'hud.cached'|trans({tokens: consumption.cached|format_number}) }}">{{ 'hud.reply'|trans }} <b>{{ consumption.reply|format_number }}</b></span>
        <span>{{ 'hud.total'|trans }} <b>{{ consumption.conversation|format_number }}</b></span>
    {% endif %}
    <form action="{{ path('coach_forget') }}" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('coach') }}">
        <button class="forget" title="{{ 'hud.forget'|trans }}" aria-label="{{ 'hud.forget'|trans }}">↺</button>
    </form>
</div>
